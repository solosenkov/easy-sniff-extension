{
  "manifest_version": 3,
  "name": "Easy Sniff 3",
  "version": "3.7.0",
  "description": "__MSG_description__",
  "minimum_chrome_version": "118",
  "permissions": [
    "storage",
    "tabs",
    "debugger",
    "scripting",
    "activeTab",
    "tabCapture",
    "offscreen"
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "__MSG_open__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "default_locale": "en",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
